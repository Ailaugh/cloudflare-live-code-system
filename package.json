{
  "name": "live-code-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "cf:build": "npm run build",
    "cf:dev": "wrangler pages dev dist",
    "cf:deploy": "npm run cf:build && wrangler pages deploy dist",
    "cf:secret": "wrangler pages secret put ADMIN_TOKEN",
    "test": "vitest run"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^3.2.4",
    "wrangler": "^4.113.0"
  }
}
